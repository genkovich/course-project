# Copy to .env (gitignored) and fill in for a LOCAL release rehearsal.
# The release skills read these from the environment; CI reads the same names as
# repository secrets. Only NAMES live here — never commit a real token.

# Gate 1 — Telegram announcement (announce-telegram / release.yml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gate 2 — Redmine wiki publish (publish-redmine / docs-publish.yml)
REDMINE_URL=
REDMINE_API_KEY=
# Wiki project slug. Default matches the GitHub repo name.
REDMINE_PROJECT=course-project

# CI only — the headless claude -p steps in release.yml. Local skills use the
# session's own auth, so you do not need this in a local .env.
# ANTHROPIC_API_KEY=
