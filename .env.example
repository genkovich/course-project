# Copy to .env (gitignored) and fill in for a LOCAL release rehearsal.
# The local mirror skills read these from the environment; CI reads the same
# names as repository secrets. Only NAMES live here — never commit a real token.

# Telegram announcement — the merge gate (release.yml) sends it in CI; the
# announce-telegram skill is the local mirror.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redmine wiki publish — the merge gate (release.yml) publishes it in CI; the
# publish-redmine skill is the local mirror.
REDMINE_URL=
REDMINE_API_KEY=
# Wiki project slug. Default matches the GitHub repo name.
REDMINE_PROJECT=course-project

# CI only — the headless `claude -p` steps in release.yml authenticate with this.
# Set it as a GitHub repository secret, not in a local .env: local skills use the
# session's own Claude auth.
# CLAUDE_CODE_OAUTH_TOKEN=
