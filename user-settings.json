 @disregard
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "language": "ukrainian",
  "voiceEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 45,
  "env": {
    "EDITOR": "nano",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SHELL": "zsh", // Override автовизначення shell. Корисно коли login shell відрізняється від робочого
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", // Один прапорець вимикає ВСЕ: телеметрію, error reporting, autoupdater, feedback
    "HTTPS_PROXY": "", // Проксі для мережевих з'єднань
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "ENABLE_TOOL_SEARCH": true ,//Контроль MCP tool search: `true` (defer завжди), `auto` (threshold), `false` (все upfront)
    "CLAUDE_CODE_NEW_INIT": true  // `/init` запускає інтерактивний setup flow замість автоматичного
  }
}